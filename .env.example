# Copy this file to .env and fill in ONE of the two options below:
#   cp .env.example .env
#
# app.py loads .env at startup. A variable already set in your shell
# takes precedence over the value here. Never commit your real .env.

# Option 1: Anthropic API key
# Create one at https://console.anthropic.com/
# Usage is billed to your Console account.
ANTHROPIC_API_KEY=

# Option 2: Claude subscription token
# Create one by running:  claude setup-token
# Usage counts against your Claude subscription.
# CLAUDE_CODE_OAUTH_TOKEN=
